# Catatan: Kredensial (THREADS_USERNAME & THREADS_PASSWORD) dipisah ke file .env.credentials
# supaya Anda bebas edit file .env tanpa perlu copy-paste ulang username/password.

# ==========================================================
# 1. KEYWORD PENCARIAN (pisahkan dengan koma)
# ==========================================================
THREADS_KEYWORDS=grup WA IELTS,grup belajar IELTS,komunitas IELTS,IELTS WhatsApp group,chat.whatsapp.com IELTS,grup WA bahasa Inggris,komunitas belajar bahasa Inggris,chat.whatsapp.com english


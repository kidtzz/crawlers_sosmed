# ==========================================================
# 2. FILTER KUALITAS & VALIDASI LINK WA
# ==========================================================
TOPIC_KEYWORDS=ielts,english,inggris,speaking,writing,listening,reading,toefl,belajar,study,beasiswa,scholarship
# Tambahan kata spam kustom (opsional, selain daftar spam bawaan seperti judi/slot/jual)
SPAM_KEYWORDS=
VALIDATE_WA_LINKS=true
WA_CHECK_DELAY_MIN=2.0
WA_CHECK_DELAY_MAX=4.5
MAX_WA_CHECKS_PER_SESSION=30
ONLY_WHATSAPP_LINKS=false

# ==========================================================
# 3. PENGATURAN OPSIONAL SCRAPER
# ==========================================================
HEADLESS=false
BLOCK_MEDIA=true
SCROLL_DELAY_MIN=1.2
SCROLL_DELAY_MAX=2.5
MAX_SCROLLS_PER_SESSION=30
MAX_SCROLLS_PER_KEYWORD=4
SCRAPE_COMMENTS=true
MAX_COMMENT_POSTS_PER_SESSION=10
MAX_COMMENT_SCROLLS_PER_POST=2
OUTPUT_CSV=hasil_grup_wa.csv
STORAGE_STATE_FILE=storage_state.json
# CREDENTIALS_FILE=.env.credentials

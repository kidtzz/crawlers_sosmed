# ==========================================================
# KREDENSIAL AKUN CADANGAN X / TWITTER (JANGAN pakai akun utama)
# Simpan sebagai file: .env.credentials
# ==========================================================
X_USERNAME=username_atau_email_cadangan
X_PASSWORD=password_akun_cadangan

# Opsional: isi handle (tanpa @) jika X meminta verifikasi username saat login pakai email
X_HANDLE=handle_tanpa_at

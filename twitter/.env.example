# Catatan: Kredensial (X_USERNAME, X_PASSWORD, X_HANDLE) dipisah ke file .env.credentials
# supaya Anda bebas edit file .env tanpa perlu copy-paste ulang kredensial.

# ==========================================================
# 1. KEYWORD PENCARIAN (pisahkan dengan koma)
# ==========================================================
X_KEYWORDS=grup WA IELTS,grup belajar IELTS,komunitas IELTS,IELTS WhatsApp group,chat.whatsapp.com IELTS,grup WA bahasa Inggris,komunitas belajar bahasa Inggris,chat.whatsapp.com english

# ==========================================================
# 2. PENGATURAN OPSIONAL SCRAPER X / TWITTER
# ==========================================================
# Mode pencarian: live (terbaru) atau top (populer)
X_SEARCH_MODE=live
HEADLESS=false
BLOCK_MEDIA=true
RESOLVE_TRUNCATED_TCO=true
SCROLL_DELAY_MIN=1.5
SCROLL_DELAY_MAX=3.0
MAX_SCROLLS_PER_SESSION=30
MAX_SCROLLS_PER_KEYWORD=4
SCRAPE_COMMENTS=true
MAX_COMMENT_POSTS_PER_SESSION=10
MAX_COMMENT_SCROLLS_PER_POST=2
OUTPUT_CSV=hasil_x_grup_wa.csv
STORAGE_STATE_FILE=storage_state.json
# CREDENTIALS_FILE=.env.credentials
